# ==============================================================================
# SkillMatch — Plantilla de variables para Docker Compose (docker.env.template)
# ==============================================================================
# INSTRUCCIONES:
# 1. Copia este archivo a `.env` en la RAÍZ del repositorio (ya ignorado por Git):
#      cp docker.env.template .env
# 2. Reemplaza los valores marcados como [SECRETO] antes de exponer el stack.
# 3. En Coolify se usa compose.coolify.yaml: define las variables en la UI
#    (Environment Variables). SECRET_KEY, POSTGRES_PASSWORD y ADMIN_PASSWORD
#    los genera Coolify (ver docs/deployment/docker.md). No subas ningún `.env`.
#
# Reglas de interpolación (compose.yaml):
# - Una variable vacía equivale a "no definida": se usa el valor por defecto del
#   compose (que puede variar entre local y producción, ver ENVIRONMENT/DEBUG).
# - Compose interpola `$` dentro de este archivo: si un secreto contiene `$`,
#   escríbelo entre comillas simples ('...').
# - Valores fijos por la topología (NO se configuran aquí): POSTGRES_HOST=postgres,
#   POSTGRES_PORT=5432, REDIS_URL=redis://redis:6379/0, CELERY_TASK_ALWAYS_EAGER=False,
#   SANDBOX_WORK_DIR=/sandbox-work, DOCKER_HOST=tcp://sandbox-docker:2376,
#   DOCKER_TLS_VERIFY=1, DOCKER_CERT_PATH=/certs/client.
# Guía: docs/deployment/docker.md
# ==============================================================================

# ==========================================
# 1. Entorno y red
# ==========================================
PROJECT_NAME="SkillMatch API"
VERSION="0.1.0"
# DESCRIPTION=""                 # Opcional; vacío = descripción por defecto de la API
# Vacío = development/True con el override local y production/False con
# `-f compose.yaml`. compose.prod.yaml fuerza production/False siempre.
# ¡development habilita la cabecera X-User-Id de pruebas! Nunca en un servidor.
ENVIRONMENT=""                   # development | staging | production
DEBUG=""                         # True | False

# Orígenes CORS (coma). Prod-like local sirve SPA y API en el mismo origen (8080);
# el servidor Vite (5173) llama a la API en :8000 y necesita CORS.
# Producción: https://<tu-dominio> (obligatoria en compose.prod.yaml).
ALLOWED_ORIGINS="http://localhost:8080,http://localhost:5173,http://127.0.0.1:8080,http://127.0.0.1:5173"

# URL pública del frontend para enlaces en correos. Vacío = http://localhost:5173
# (override local) o http://localhost:8080 (prod-like). Obligatoria en producción.
FRONTEND_BASE_URL=""

# ==========================================
# 2. PostgreSQL (servicio `postgres`)
# ==========================================
POSTGRES_USER="skillmatch_user"
# [SECRETO CRÍTICO] SOLO letras y números: el backend arma la DSN sin URL-encoding.
# Generar: openssl rand -hex 24
POSTGRES_PASSWORD="skillmatchlocal"
POSTGRES_DB="skillmatch_db"
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# ==========================================
# 3. Seguridad y JWT
# ==========================================
# [SECRETO CRÍTICO] Generar: openssl rand -hex 32
SECRET_KEY="change-me-local-only-run-openssl-rand-hex-32"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440                 # 24 horas
REFRESH_TOKEN_EXPIRE_DAYS=30
WS_TICKET_EXPIRE_SECONDS=30                      # 5-120 s

# ==========================================
# 4. Administrador inicial (seed al arrancar la API)
# ==========================================
ADMIN_EMAIL="admin@skillmatch.io"
ADMIN_PASSWORD="ChangeMeLocalAdmin123!"          # [SECRETO CRÍTICO] Cambiar en producción
ADMIN_FULL_NAME="Administrador Principal"

# ==========================================
# 5. Google Identity Services (miembros)
# ==========================================
# Vacío = login con Google responde 503 (no configurado). Obligatoria en producción.
GOOGLE_CLIENT_ID=""

# ==========================================
# 6. Corrección teórica (texto) y ASR local
# ==========================================
THEORY_GRADING_PROVIDER="disabled"               # disabled | openai | gemini
THEORY_GRADING_MODEL=""                          # Modelo explícito; sin valor por defecto
OPENAI_API_KEY=""                                # [SECRETO] Solo si el proveedor es openai
GEMINI_API_KEY=""                                # [SECRETO] Solo si el proveedor es gemini
THEORY_GRADING_TIMEOUT_SECONDS=20
THEORY_ASR_ENABLED=True                          # El modelo Whisper no se provisiona en la imagen (ver guía)

# ==========================================
# 7. Sandbox de programación (dind aislado)
# ==========================================
# `sandbox-init` la descarga en el daemon dind antes de arrancar el backend.
SANDBOX_DOCKER_IMAGE="python:3.12-slim"
SANDBOX_DOCKER_BINARY="docker"                   # CLI incluido en la imagen del backend
SANDBOX_MAX_CONCURRENT_RUNS=2

# ==========================================
# 8. Garage S3 externo (Coolify)
# ==========================================
GARAGE_S3_ENDPOINT_URL="https://s3.devhooh.com"
GARAGE_S3_REGION="garage"
GARAGE_S3_ACCESS_KEY_ID=""                       # Obligatoria en producción
GARAGE_S3_SECRET_ACCESS_KEY=""                   # [SECRETO] Obligatoria en producción
GARAGE_S3_BUCKET="skillmatch-football"
GARAGE_S3_FORCE_PATH_STYLE=True

# ==========================================
# 9. Correo transaccional (SMTP)
# ==========================================
# Si EMAIL_ENABLED=True pero faltan credenciales o remitente, el envío se omite y se registra un error.
EMAIL_ENABLED=False
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USERNAME=""                                 # [SECRETO]
SMTP_PASSWORD=""                                 # [SECRETO] Contraseña de aplicación
SMTP_STARTTLS=True
SMTP_TIMEOUT_SECONDS=15
EMAIL_FROM_ADDRESS=""                            # ej. no-reply@skillmatch.io
EMAIL_FROM_NAME="SkillMatch"
EMAIL_REPLY_TO=""                                # Opcional

# ==========================================
# 10. Web Push (VAPID)
# ==========================================
# Con WEB_PUSH_ENABLED=True las tres VAPID_* son obligatorias (la API no arranca
# sin ellas) y VAPID_SUBJECT debe empezar por mailto: o https://.
WEB_PUSH_ENABLED=False
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""                             # [SECRETO]
VAPID_SUBJECT=""                                 # ej. mailto:soporte@skillmatch.io

# ==========================================
# 11. Frontend (build args: se INCRUSTAN en el bundle al construir)
# ==========================================
# Cambiar cualquiera exige reconstruir: docker compose build frontend
# URL absoluta terminada en /api. Vacío = http://localhost:8080/api (prod-like local).
# Producción (obligatoria): https://<tu-dominio>/api. El override local de Vite usa
# siempre http://localhost:8000/api.
VITE_API_URL=""
VITE_APP_ENV=""                                  # Vacío = production (bundle nginx)
VITE_GOOGLE_CLIENT_ID=""                         # Vacío = mismo valor que GOOGLE_CLIENT_ID
VITE_GOOGLE_IOS_CLIENT_ID=""
VITE_BROWSER_SUPERVISION_TRIAL=""                # "" | true | false; nunca activo con VITE_APP_ENV=production

# ==========================================
# 12. Knobs de Compose y procesos
# ==========================================
FRONTEND_PORT=8080                               # Puerto publicado del nginx (solo compose.yaml)
# Puertos del host para Postgres/Redis (solo compose.override.yaml, ligados a 127.0.0.1).
# Distintos de 5432/6379 para no chocar con un Postgres/Redis instalado en el host.
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6380
UVICORN_WORKERS=""                               # Vacío = 1 (base) / 2 (compose.prod.yaml)
CELERY_CONCURRENCY=2
CELERY_LOG_LEVEL="info"
BACKEND_IMAGE="skillmatch-backend:local"
FRONTEND_IMAGE="skillmatch-frontend:local"
