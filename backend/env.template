# ==========================================
# Configuración General del Entorno
# ==========================================
PROJECT_NAME="SkillMatch API"
VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=True

# Orígenes CORS permitidos (separados por coma o formato JSON)
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173"

# ==========================================
# Base de Datos PostgreSQL Asíncrona
# ==========================================
POSTGRES_HOST="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="skillmatch_user"
POSTGRES_PASSWORD="skillmatch_password"
POSTGRES_DB="skillmatch_db"

# Opcional: Anular con DSN directa
# DATABASE_URL="postgresql+asyncpg://skillmatch_user:skillmatch_password@localhost:5432/skillmatch_db"

# Parámetros del Pool de Conexiones
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# ==========================================
# Seguridad y Tokens JWT
# ==========================================
SECRET_KEY="replace-this-secret-key-in-production-with-openssl-rand-hex-32"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30
