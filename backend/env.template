# ==============================================================================
# SkillMatch Backend — Plantilla Maestra de Variables de Entorno (env.template)
# ==============================================================================
# INSTRUCCIONES:
# 1. Copia este archivo a `.env` en la carpeta `backend/` o raíz del proyecto:
#    cp env.template .env
# 2. Reemplaza todos los valores marcados como [SECRETO] antes de ejecutar.
# 3. NUNCA subas archivos .env con credenciales reales a Git.
# ==============================================================================

# ==========================================
# 1. Configuración de Entorno y Red
# ==========================================
PROJECT_NAME="SkillMatch API"
VERSION="0.1.0"
ENVIRONMENT="development"       # development | staging | production
DEBUG=True

# Orígenes autorizados para CORS (separados por coma)
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173"

# ==========================================
# 2. Base de Datos PostgreSQL Asíncrona (asyncpg)
# ==========================================
POSTGRES_HOST="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="skillmatch_user"
POSTGRES_PASSWORD="skillmatch_password"          # [SECRETO CRÍTICO] Cambiar en producción
POSTGRES_DB="skillmatch_db"

# Opcional: DSN directa (si se define, tiene precedencia sobre los campos individuales)
# DATABASE_URL="postgresql+asyncpg://skillmatch_user:skillmatch_password@localhost:5432/skillmatch_db"

# Parámetros del Pool de Conexiones
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# ==========================================
# 3. Seguridad Criptográfica y JWT
# ==========================================
# Generar clave segura en producción con: openssl rand -hex 32
SECRET_KEY="09d25e094faa6ca2556c818166b7a9563b93f7099f6f0f4caa6cf63b88e8d3e7" # [SECRETO CRÍTICO]
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440                 # 24 Horas
REFRESH_TOKEN_EXPIRE_DAYS=30                     # 30 Días

# ==========================================
# 4. Credenciales del Administrador Inicial (Seed Automático)
# ==========================================
# El sistema provisiona automáticamente un único usuario con rol ADMIN al arrancar
# si no existe en la base de datos.
ADMIN_EMAIL="admin@skillmatch.io"
ADMIN_PASSWORD="SuperSecretAdminPassword123!"     # [SECRETO CRÍTICO] Cambiar inmediatamente
ADMIN_FULL_NAME="Administrador Principal"

# ==========================================
# 5. Proveedores de Autenticación Social & OTP (Sprint 0 - HU-07)
# ==========================================
# Google OAuth 2.0
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""                          # [SECRETO]

# GitHub OAuth
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""                          # [SECRETO]

# WhatsApp Business Cloud API (OTP sin contraseña)
WHATSAPP_API_KEY=""                              # [SECRETO]
WHATSAPP_PHONE_NUMBER_ID=""

# ==========================================
# 6. Almacenamiento de Evidencias y MinIO S3 (Sprint 1 al 4)
# ==========================================
MINIO_ENDPOINT="localhost:9000"
MINIO_ROOT_USER="minioadmin"
MINIO_ROOT_PASSWORD="minioadmin"                 # [SECRETO] Cambiar en producción
MINIO_SECURE=False                               # True para HTTPS en producción
MINIO_DEFAULT_BUCKET="skillmatch-media"
