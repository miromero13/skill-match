# Build context hygiene for frontend/Dockerfile.
# Dependencies and build output are produced inside the image.
node_modules
dist
dist-ssr
coverage

# Native shells are not part of the web image.
android
ios

# Local env files never enter the image (VITE_* come from build args).
.env
.env.*
*.local

# Generated by scripts/install-vision-assets.mjs inside the image.
public/mediapipe

*.log
.git
.vscode
.idea
.DS_Store
Dockerfile
.dockerignore
