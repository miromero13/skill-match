# ==============================================================================
# SkillMatch Frontend — Variables de Entorno (.env)
# ==============================================================================

# URL base de la API backend de FastAPI.
# En desarrollo local con Vite, si se deja en "/api", las solicitudes pasan a través
# del proxy reverso de Vite hacia http://localhost:8000 para evitar problemas de CORS.
# En producción o staging, especificar la URL absoluta del dominio backend:
# Ej: "https://api.skillmatch.io/api"
VITE_API_URL="/api"

# Nombre del entorno de despliegue ("development" | "staging" | "production")
VITE_APP_ENV="development"

# Título y metadatos de la aplicación
VITE_APP_NAME="SkillMatch"
VITE_APP_VERSION="0.1.0"
