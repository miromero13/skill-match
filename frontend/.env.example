# ==============================================================================
# SkillMatch Frontend — Variables de Entorno (.env)
# ==============================================================================

# URL base absoluta del backend FastAPI.
# En desarrollo local: "http://localhost:8000/api"
# En producción o staging: "https://api.skillmatch.io/api"
VITE_API_URL="http://localhost:8000/api"

# Nombre del entorno de despliegue ("development" | "staging" | "production")
VITE_APP_ENV="development"

# Título y metadatos de la aplicación
VITE_APP_NAME="SkillMatch"
VITE_APP_VERSION="0.1.0"
