                      ],
                      "cornerRadius": 6.0,
                      "fill": [
                        {
                          "type": "solid",
                          "color": "#0B1012"
                        }
                      ],
                      "children": [
                        {
                          "type": "text",
                          "id": "n4940",
                          "name": "L1",
                          "width": "fit_content",
                          "height": "fit_content",
                          "content": "@router.get('/skills/{id}/stats')",
                          "fontSize": 10.0,
                          "fontWeight": 500,
                          "textGrowth": "auto",
                          "fill": [
                            {
                              "type": "solid",
                              "color": "#38BDF8"
                            }
                          ]
                        },
                        {
                          "type": "text",
                          "id": "n4941",
                          "name": "L2",
                          "width": "fit_content",
                          "height": "fit_content",
                          "content": "async def get_stats(id: int, r: Redis = Depends()):",
                          "fontSize": 10.0,
                          "fontWeight": 500,
                          "textGrowth": "auto",
                          "fill": [
                            {
                              "type": "solid",
                              "color": "#F0FDFA"
                            }
                          ]
                        },
                        {
                          "type": "text",
                          "id": "n4942",
                          "name": "L3",
                          "width": "fit_content",
                          "height": "fit_content",
                          "content": "    if c := await r.get(f's:{id}'): return json.loads(c)",
                          "fontSize": 10.0,
                          "fontWeight": 500,
                          "textGrowth": "auto",
                          "fill": [
                            {
                              "type": "solid",
                              "color": "#34D399"
                            }
                          ]
                        },
                        {
                          "type": "text",
                          "id": "n4943",
                          "name": "L4",
                          "width": "fit_content",
                          "height": "fit_content",
                          "content": "    stats = await db.fetch_skill_stats(id)",
                          "fontSize": 10.0,
                          "fontWeight": 500,
                          "textGrowth": "auto",
                          "fill": [
                            {
                              "type": "solid",
                              "color": "#E3E7E8"
                            }
                          ]
                        },
                        {
                          "type": "text",
                          "id": "n4944",
                          "name": "L5",
                          "width": "fit_content",
                          "height": "fit_content",
                          "content": "    if not stats: raise HTTPException(404)",
                          "fontSize": 10.0,
                          "fontWeight": 500,
                          "textGrowth": "auto",
                          "fill": [
                            {
                              "type": "solid",
                              "color": "#F87171"
                            }
                          ]
                        },
                        {
                          "type": "text",
                          "id": "n4945",
                          "name": "L6",
                          "width": "fit_content",
                          "height": "fit_content",
                          "content": "    await r.setex(f's:{id}', 60, json.dumps(stats))",
                          "fontSize": 10.0,
                          "fontWeight": 500,
                          "textGrowth": "auto",
                          "fill": [
                            {
                              "type": "solid",
                              "color": "#34D399"
                            }
                          ]
                        }
