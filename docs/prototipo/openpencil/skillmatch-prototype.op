                              "type": "text",
                              "id": "n2086",
                              "name": "Code",
                              "width": "fit_content",
                              "height": "fit_content",
                              "content": "    cache_key = f'skill:stats:{id}'",
                              "fontSize": 12.0,
                              "fontWeight": 500,
                              "textGrowth": "auto",
                              "fill": [
                                {
                                  "type": "solid",
